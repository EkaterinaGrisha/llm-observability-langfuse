# Скопируйте этот файл в .env и укажите свои ключи. Файл .env в репозиторий не добавляется.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# необязательно: модель-оценщик LLM-as-a-Judge (без ключа используется GigaChat-2-Max)
DEEPSEEK_API_KEY=
